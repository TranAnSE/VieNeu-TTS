# VieNeu-TTS Web UI — CPU image (v3 Turbo via ONNX Runtime + v3 Nano), torch-free.
# Small image for laptops, mini PCs and servers without a GPU.
#
#   docker build -t vieneu-tts:cpu -f docker/Dockerfile.cpu .
#   docker run -p 7860:7860 -v hf_cache:/root/.cache/huggingface vieneu-tts:cpu
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/root/.cache/huggingface \
    UV_PROJECT_ENVIRONMENT="/opt/venv" \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /workspace

# Dependencies first (cached layer), then the project itself.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev

EXPOSE 7860
ENV GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    GRADIO_SHARE=0
CMD ["vieneu-web"]
